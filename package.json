{
  "name": "antigravity-i18n",
  "version": "0.1.0",
  "description": "跨平台 Google Antigravity 繁體中文（zh-TW）與簡體中文（zh-CN）中文化 CLI 工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carinoasd/antigravity-i18n.git"
  },
  "homepage": "https://github.com/Carinoasd/antigravity-i18n#readme",
  "bugs": {
    "url": "https://github.com/Carinoasd/antigravity-i18n/issues"
  },
  "type": "module",
  "bin": {
    "antigravity-i18n": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "locales",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node dist/cli.js validate",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && node dist/cli.js validate",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "antigravity",
    "i18n",
    "l10n",
    "zh-TW",
    "zh-CN",
    "chinese",
    "localization",
    "electron",
    "asar",
    "google-antigravity",
    "wallpaper",
    "background",
    "theme",
    "custom-theme"
  ],
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
